{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, LOWER(btrim(p.email)) AS email, p.active\n        FROM org.people p\n        WHERE LOWER(btrim(p.email)) = ANY($1)\n           OR EXISTS (\n               SELECT 1 FROM org.platform_identities pi\n               WHERE pi.person_id = p.id AND pi.platform = $3\n                 AND pi.platform_user_id = ANY($2)\n           )\n        ORDER BY p.id\n        FOR UPDATE OF p\n        ",
