  "query": "\n        SELECT id, platform_id, person_id, created_at, updated_at, closed_at,\n            (to_jsonb(c) - ARRAY['id','ingested_at']) AS \"input!\"\n        FROM activity.contributions c\n        WHERE platform = $1 AND platform_id = ANY($2)\n        ORDER BY id FOR UPDATE\n        ",
