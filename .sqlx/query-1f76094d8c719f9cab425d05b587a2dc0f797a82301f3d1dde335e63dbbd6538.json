  "query": "\n            SELECT id, directory_id,\n                   lower(btrim(email)) = lower($3) AS email_matches\n            FROM org.people\n            WHERE id = $1\n               OR ($2::text IS NOT NULL AND directory_id = $2)\n               OR ($3::text IS NOT NULL AND lower(btrim(email)) = lower($3))\n            FOR UPDATE\n            ",
