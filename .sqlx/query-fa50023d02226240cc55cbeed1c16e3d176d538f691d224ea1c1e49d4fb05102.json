{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT platform_username, min(person_id::text)::uuid AS \"person_id!\"\n            FROM org.platform_identities\n            WHERE platform = $1\n              AND platform_username = ANY($2)\n            GROUP BY platform_username\n            HAVING count(DISTINCT person_id) = 1\n            ",
